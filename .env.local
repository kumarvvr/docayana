# Copy to .env for local runs. Every setting is read with the DOCAYANA_ prefix.
DOCAYANA_ENVIRONMENT=local
DOCAYANA_LOG_LEVEL=INFO
DOCAYANA_AWS_REGION=us-east-1
DOCAYANA_DYNAMODB_TABLE_NAME=docayana
# Point at DynamoDB Local for manual runs, e.g. http://localhost:8000
DOCAYANA_DYNAMODB_ENDPOINT_URL=
DOCAYANA_OTEL_ENABLED=false
DOCAYANA_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
